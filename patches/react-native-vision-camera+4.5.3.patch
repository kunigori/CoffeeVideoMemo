+  /**
+   Checks whether the active AVCaptureDevice in the running session supports `.locked` exposure mode.
+   */
+  func isExposureLockSupported(completion: @escaping (Result<Bool, CameraError>) -> Void) {
+    CameraQueues.cameraQueue.async {
+      guard let device = self.videoDeviceInput?.device else {
+        completion(.failure(.session(.cameraNotReady)))
+        return
+      }
+      let supported = device.isExposureModeSupported(.locked)
+      completion(.success(supported))
+    }
+  }
+
+  /**
+   Locks or unlocks auto-exposure on the active AVCaptureDevice and verifies that exposureMode transitioned.
+   */
+  func setExposureLocked(_ locked: Bool, completion: @escaping (Result<Bool, CameraError>) -> Void) {
+    CameraQueues.cameraQueue.async {
+      guard self.captureSession.isRunning, let device = self.videoDeviceInput?.device else {
+        completion(.failure(.session(.cameraNotReady)))
+        return
+      }
+
+      if locked {
+        guard device.isExposureModeSupported(.locked) else {
+          completion(.failure(.unknown(message: "Exposure lock (.locked) is not supported on this AVCaptureDevice.")))
+          return
+        }
+        do {
+          try device.lockForConfiguration()
+          defer {
+            device.unlockForConfiguration()
+          }
+          device.exposureMode = .locked
+          let applied = device.exposureMode == .locked
+          self.isExposureLocked = applied
+          completion(.success(applied))
+        } catch {
+          completion(.failure(.device(.configureError)))
+        }
+      } else {
+        let targetMode: AVCaptureDevice.ExposureMode
+        if device.isExposureModeSupported(.continuousAutoExposure) {
+          targetMode = .continuousAutoExposure
+        } else if device.isExposureModeSupported(.autoExpose) {
+          targetMode = .autoExpose
+        } else {
+          completion(.failure(.unknown(message: "Auto-exposure mode is not supported on this AVCaptureDevice.")))
+          return
+        }
+        do {
+          try device.lockForConfiguration()
+          defer {
+            device.unlockForConfiguration()
+          }
+          device.exposureMode = targetMode
+          let unlocked = device.exposureMode == targetMode
+          self.isExposureLocked = false
+          completion(.success(unlocked))
+        } catch {
+          completion(.failure(.device(.configureError)))
+        }
+      }
+    }
+  }
 }
