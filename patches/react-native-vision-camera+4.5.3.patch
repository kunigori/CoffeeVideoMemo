+        val values = ContentValues().apply {
+          put(MediaStore.Video.Media.DISPLAY_NAME, fileName)
+          put(MediaStore.Video.Media.MIME_TYPE, "video/mp4")
+          if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            put(MediaStore.Video.Media.RELATIVE_PATH, Environment.DIRECTORY_DCIM + "/Camera")
+            put(MediaStore.Video.Media.IS_PENDING, 1)
+          }
+        }
+
+        val collection = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+          MediaStore.Video.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY)
+        } else {
+          MediaStore.Video.Media.EXTERNAL_CONTENT_URI
+        }
+
+        val itemUri = resolver.insert(collection, values)
+        if (itemUri == null) {
+          promise.reject("storage/save-failed", "MediaStoreへのエントリ作成に失敗しました。")
+          return@launch
+        }
+
+        resolver.openOutputStream(itemUri)?.use { outStream ->
+          FileInputStream(sourceFile).use { inStream ->
+            inStream.copyTo(outStream)
+          }
+        } ?: run {
+          promise.reject("storage/save-failed", "保存先ストリームを開けませんでした。")
+          return@launch
+        }
+
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+          val completeValues = ContentValues().apply {
+            put(MediaStore.Video.Media.IS_PENDING, 0)
+          }
+          resolver.update(itemUri, completeValues, null, null)
+        }
+
+        promise.resolve(itemUri.toString())
+      } catch (e: Throwable) {
+        promise.reject("storage/save-failed", e.message ?: "ギャラリーへの動画保存に失敗しました。", e)
+      }
+    }
+  }
